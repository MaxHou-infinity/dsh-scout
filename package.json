{
  "name": "dsh-scout",
  "version": "0.9.3",
  "description": "Evidence-driven company and job intelligence plugin for DeepSeek Harness.",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "assets",
    "scripts/check-release.mjs",
    "scripts/profile-smoke.mjs",
    "README.md",
    "LICENSE",
    "docs/dsh-scout-product-contract.md",
    "docs/fixtures/dsh-scout/snapmaker-hr-head.json",
    "tests/model.test.mjs",
    "tests/package.test.mjs",
    "tests/tools.test.mjs",
    "tests/acceptance.test.mjs",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test",
    "test:profile": "node scripts/profile-smoke.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxHou-infinity/dsh-scout.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "company-research",
    "job-intelligence",
    "hrbp"
  ]
}
